# 将需要的项加入服务器现有 .env，不要覆盖原来的 QQ / 综测配置。
# 平台发信账号；用户只提供自己的收件邮箱及验证码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_BASE_URL=http://38.207.179.218:18086
# 保留项目现有 DeepSeek API key；模型须与账号 /models 返回的可用列表一致。
DEEPSEEK_MODEL=deepseek-flash
STUDENT_AI_DAILY_LIMIT=10
# 文件与数据库同属持久化 /data 卷。
STUDENT_FILES_PATH=/data/student-files
